<launch>
  <!-- Compatibility entry; new callers can use identification_fsm.launch directly. -->
  <arg name="environment" default="sim"/>
  <arg name="config" default="$(find holydrone_identification)/config/excitation.yaml"/>
  <arg name="auto_takeoff" default="false"/>
  <arg name="enable_real_excitation" default="false"/>
  <include file="$(find holydrone_identification)/launch/identification_fsm.launch">
    <arg name="environment" value="$(arg environment)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="auto_takeoff" value="$(arg auto_takeoff)"/>
    <arg name="enable_real_excitation" value="$(arg enable_real_excitation)"/>
  </include>
</launch>
