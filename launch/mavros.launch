<launch>
  <arg name="fcu_url" default="udp://:14540@127.0.0.1:14557"/>
  <arg name="target_system" default="1"/>
  <arg name="sim_imu_interval_us" default="$(optenv SIM_IMU_INTERVAL_US 10000)"/>

  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="gcs_url" value=""/>
    <arg name="tgt_system" value="$(arg target_system)"/>
    <arg name="tgt_component" value="1"/>
  </include>

  <node pkg="holydrone" type="configure_mavlink_streams.py"
        name="configure_sim_mavlink_streams" output="screen">
    <param name="interval_us" value="$(arg sim_imu_interval_us)"/>
    <rosparam param="message_ids">[105, 31]</rosparam>
  </node>
</launch>
